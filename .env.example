# ==============================================================================
# Mediplus Hospital Management System - Backend Environment Configuration
# Copy this file to .env for local development or set in Vercel Project Settings
# ==============================================================================

# Application Environment (production, development, testing)
DJANGO_ENV=production

# Disable debug mode in production (False)
DJANGO_DEBUG=False

# Django Secret Key (Generate a random 50+ character string for production)
DJANGO_SECRET_KEY=generate-a-secure-random-key-for-production-deployment-here

# Allowed Hostnames (Comma-separated hostnames without http/https schemes)
# The default already includes mediplus-master-be.vercel.app, .vercel.app, and localhost
DJANGO_ALLOWED_HOSTS=mediplus-master-be.vercel.app,localhost,127.0.0.1

# CSRF Trusted Origins (Comma-separated URLs WITH http:// or https:// schemes)
# Required for Django 4+ and 6+ secure form and API submissions
CSRF_TRUSTED_ORIGINS=https://mediplus-master-be.vercel.app,https://mediplus-master.vercel.app,https://mediplus-master-fe.vercel.app,http://localhost:4200

# CORS Allowed Origins for Frontend (Comma-separated URLs WITH http:// or https:// schemes)
CORS_ALLOWED_ORIGINS=https://mediplus-master.vercel.app,https://mediplus-master-fe.vercel.app,http://localhost:4200,http://127.0.0.1:4200

# Optional: Production Database URL (e.g., PostgreSQL on Supabase, Neon, or Neon Postgres)
# If omitted, falls back to local hospital.db
# DATABASE_URL=postgres://user:password@host:port/dbname
